                "properties": {
                  "code": {
                    "description": "微信 wx.login 返回的 code",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "properties": {
                        "token": {
                          "type": "object"
                        },
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "openid": {
                          "type": "string"
                        },
                        "unionid": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "code is required"
          }
        }
      }
    },
