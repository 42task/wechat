    "/v2/site/refresh-token": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "刷新访问令牌",
        "description": "使用 refreshToken 获取新的访问令牌",
        "operationId": "1ba04ec34cae72a67a86afe3c50f3ba0",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refreshToken": {
                    "description": "刷新令牌",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刷新成功",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "properties": {
                        "token": {
                          "properties": {
                            "accessToken": {
                              "type": "string"
                            },
                            "expires": {
                              "type": "string"
                            },
                            "refreshToken": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v2/site/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "微信小程序登录",
        "description": "使用微信 code 进行登录，获取访问令牌",
        "operationId": "25e77f143e37eebc073469dd58c43dba",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "code"
