    "/v2/server/device": {
      "post": {
        "tags": [
          "服务器"
        ],
        "summary": "设备刷新",
        "operationId": "ffa0087848579b67f9956b5390b05404",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "uuid": {
                    "description": "设备 UUID",
                    "type": "string"
                  },
                  "version": {
                    "description": "设备版本号；省略时更新为 0",
                    "type": "integer",
                    "format": "int32",
                    "default": 0,
                    "maximum": 2147483647,
                    "minimum": 0
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/v2/server/refresh": {
      "get": {
        "tags": [
          "服务器"
        ],
        "summary": "获取刷新状态",
        "operationId": "de8a9568fa369edd6b5189e5b3fbec03",
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      },
      "post": {
        "tags": [
          "服务器"
        ],
        "summary": "触发刷新",
        "operationId": "0f99582208e7d696b0d75f3f52f378b5",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "version": {
                    "description": "随设备 UUID 上报的版本号；省略时更新为 0",
                    "type": "integer",
                    "format": "int32",
                    "default": 0,
                    "maximum": 2147483647,
                    "minimum": 0
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/v2/server/info": {
      "get": {
        "tags": [
          "服务器"
        ],
        "summary": "获取服务器信息",
        "operationId": "8c9004e35e9f60d209163453bb537327",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "description": "设备 UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "description": "设备版本号；省略时按 0 处理，与数据库版本不同时更新",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "maximum": 2147483647,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "设备版本号无效"
          }
        }
      }
    },
